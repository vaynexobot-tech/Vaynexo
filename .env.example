# ======== Telegram ========
BOT_TOKEN=123456789:AA...            # @BotFather dan
BOT_USERNAME=vaynexo_bot             # @ belgisisiz
DOMAIN=app.vaynexo.uz                # serveringiz domeni (DNS A-yozuvi server IP siga)
WEBAPP_URL=https://app.vaynexo.uz
BOT_WEBHOOK_URL=https://app.vaynexo.uz   # bo'sh qoldirsangiz bot polling rejimida ishlaydi
BOT_WEBHOOK_SECRET=uzun-tasodifiy-satr
ADMIN_IDS=123456789                  # adminlar Telegram ID, vergul bilan
ADMIN_CHAT_ID=0                      # ogohlantirishlar guruhi (ixtiyoriy). Guruhga botni qo'shib /id yozing
BOOSTER_GROUP_ID=0                   # boosterlar yopiq guruhi (ixtiyoriy)

# ======== Xavfsizlik ========
POSTGRES_PASSWORD=kuchli-parol
# Yaratish: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# DIQQAT: bu kalitni yo'qotsangiz, saqlangan akkaunt parollarini o'qib bo'lmaydi.
ENCRYPTION_KEY=
CORS_ORIGINS=https://app.vaynexo.uz

# ======== P2P to'ldirish ========
P2P_CARD_NUMBER=8600 1234 5678 9012
P2P_CARD_HOLDER=ISM FAMILIYA
P2P_SECRET=uzun-tasodifiy-satr       # SMS-forwarder ilovasi X-P2P-Secret sarlavhasida yuboradi
TOPUP_MIN=1000
TOPUP_MAX=20000000
TOPUP_TTL_MINUTES=30

# ======== Biznes ========
COMMISSION_PERCENT=5
WITHDRAW_MIN=10000
ESCROW_AUTO_RELEASE_HOURS=48
REFERRAL_BONUS=0
STARS_RATE=220

# ======== Donat provayder ========
DONATE_PROVIDER=mock                 # sinov uchun mock; haqiqiy API ulanganda: http
DONATE_PROVIDER_URL=
DONATE_PROVIDER_KEY=

DEV_MODE=false
