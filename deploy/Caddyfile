{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /tg/webhook {
		reverse_proxy api:8000
	}
	handle_path /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/media
		file_server
	}
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
