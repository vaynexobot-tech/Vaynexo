# Tanishuv bot: ichki papkalarni tashqi kirishdan yopish (Apache / LiteSpeed).
# DIQQAT: Nginx .htaccess faylini o‘qimaydi. Nginx bo‘lsa document root ni public/ ga qo‘ying
# yoki server konfiguratsiyasida src, locales, sql, docs, tests, storage va config*.php ni yoping.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(src|locales|sql|config|docs|tests|storage)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "(^config(\.example)?\.php$|\.(sql|md|txt|log|json|part|sh|lock)$|^\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
